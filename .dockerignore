# Persistent databases, uploads, backups and tunnel credentials must never
# enter the build context, even when their contents have unfamiliar extensions.
/data/
.git/
.venv/
venv/
env/
**/__pycache__/
**/*.py[cod]
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/media/
**/staticfiles/
**/collected_static/
**/.pytest_cache/
**/.ruff_cache/
**/node_modules/
**/.coverage*
htmlcov/
.env
.env.*
!.env.example
**/*.pem
**/*.key
**/*.dump
**/*.pg_dump
**/*.sql.gz
backups/

# Docker Compose configuration (automatically read from root .env).
# Run python3 scripts/init_docker.py as your normal user BEFORE Docker.
# It creates data/ and generates only the Django secret.
# Set your own PostgreSQL password below; setup never generates or changes it.
#
# PostgreSQL and Redis are INCLUDED in the stack. No connection URLs needed:
# Django connects to db:5432 and redis:6379 automatically via Compose.

# Public hostname and Django secret
PUBLIC_HOSTNAME=school.example.com
SECRET_KEY=GENERATE_DJANGO_SECRET

# Bundled PostgreSQL: the only two database settings. Enter your own password.
POSTGRES_USER=school
POSTGRES_PASSWORD=

# Bundled Redis: no settings needed. Compose uses redis://redis:6379/1.

# ─────────────────────────────────────────
# Email (defaults to console output; configure SMTP to send real messages)
# ─────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@schoolname.edu

# ─────────────────────────────────────────
# School identity
# ─────────────────────────────────────────
SCHOOL_NAME=My School
SCHOOL_MOTTO=Excellence in Education
SCHOOL_PHONE=+000000000000
SCHOOL_EMAIL=info@schoolname.edu

# ─────────────────────────────────────────
# Sentry (optional, leave blank to disable)
# ─────────────────────────────────────────
SENTRY_DSN=

# Tunnel / security
# Store the dashboard-managed tunnel token in data/secrets/cloudflared-token.
# In Cloudflare, point PUBLIC_HOSTNAME to HTTP service web:8080.
# Compose selects production settings: DEBUG=False, secure cookies, and allowed
# hosts/CSRF origins derived from PUBLIC_HOSTNAME. No host ports are published.
# All durable service state lives under ./data/.

# Standalone development (python manage.py runserver, outside Docker) defaults
# to SQLite and local-memory cache. Optional DATABASE_URL and CACHE_URL overrides
# are only for that standalone setup, not needed or used by this Compose stack.

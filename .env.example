# ─────────────────────────────────────────
# Django / App
# ─────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────
# Database
# Set DATABASE_URL to a postgres:// URL in production.
# Leave blank to use SQLite in development.
# ─────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────
# Email (development uses console backend)
# ─────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@schoolname.edu

# ─────────────────────────────────────────
# School identity
# ─────────────────────────────────────────
SCHOOL_NAME=My School
SCHOOL_MOTTO=Excellence in Education
SCHOOL_PHONE=+000000000000
SCHOOL_EMAIL=info@schoolname.edu

# ─────────────────────────────────────────
# Sentry (optional, leave blank to disable)
# ─────────────────────────────────────────
SENTRY_DSN=

# ─────────────────────────────────────────
# Cache (leave blank → local-memory in dev)
# CACHE_URL=redis://127.0.0.1:6379/1
# ─────────────────────────────────────────
CACHE_URL=

# ─────────────────────────────────────────
# Security (production)
# ─────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

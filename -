  /api/v1/clients/:
    get:
      operationId: clients_list
      description: |-
        Admin-only endpoint for managing API keys.

        POST /api/v1/clients/ — creates a new client and returns the plain key
                                ONCE.  Store it immediately; it cannot be recovered.
        POST /api/v1/clients/{id}/revoke/ — deactivates the key.
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - API Clients
      security:
      - APIKeyAuth: []
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAPIClientList'
          description: ''
    post:
      operationId: clients_create
      description: |-
        Admin-only endpoint for managing API keys.

        POST /api/v1/clients/ — creates a new client and returns the plain key
                                ONCE.  Store it immediately; it cannot be recovered.
        POST /api/v1/clients/{id}/revoke/ — deactivates the key.
      tags:
      - API Clients
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/APIClientCreateRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/APIClientCreateRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/APIClientCreateRequest'
        required: true
      security:
      - APIKeyAuth: []
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/APIClientCreate'
          description: ''
  /api/v1/clients/{id}/:
    get:
      operationId: clients_retrieve
      description: |-
        Admin-only endpoint for managing API keys.

        POST /api/v1/clients/ — creates a new client and returns the plain key
